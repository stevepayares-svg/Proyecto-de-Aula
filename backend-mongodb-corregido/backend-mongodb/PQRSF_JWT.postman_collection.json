{
  "info": {
    "name": "PQRSF - JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login (guarda el token)",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const r = pm.response.json();",
          "if (r.token) { pm.collectionVariables.set('token', r.token); }",
          "pm.test('Devuelve token', () => pm.expect(r.token).to.be.a('string'));"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@bodytech.com\",\n  \"password\": \"admin123\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "2. Quien soy (con token)",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "3. Listar solicitudes (con token)",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/solicitudes"
      }
    },
    {
      "name": "4. Listar solicitudes SIN token (401)",
      "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/api/solicitudes" }
    }
  ]
}
